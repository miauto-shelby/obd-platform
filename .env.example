# Copia este archivo como .env. Nunca subas el archivo .env al repositorio.
# No pegues estos valores en capturas, tickets, commits o mensajes.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=my_auto
# Genera un valor largo y aleatorio para cada ambiente. Por ejemplo, en PowerShell:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Required only while intentionally granting the persistent ADMIN role through the local command.
# ADMIN_ROLE_MAINTENANCE=true
# ROLE_CHANGE_ACTOR=responsable@ejemplo.com
# Required only when you intentionally create a local Postman test token.
# Keep this disabled or absent for normal backend execution.
# POSTMAN_TEST_MODE=true
