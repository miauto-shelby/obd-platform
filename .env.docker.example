# Solo para Docker local. No usar en producción y no subir .env.docker a Git.
# MongoDB local se configura automáticamente desde compose.local.yaml.
JWT_SECRET=local-development-secret-change-before-sharing

# Opcional. Déjalo vacío para usar el Client ID de desarrollo configurado en el backend.
GOOGLE_WEB_CLIENT_ID=

# Requerido solamente mientras se asigna de forma intencional el rol ADMIN persistente.
# ADMIN_ROLE_MAINTENANCE=true
# ROLE_CHANGE_ACTOR=responsable@ejemplo.com

# Solo se habilita para generar un token temporal desde el contenedor de pruebas.
# POSTMAN_TEST_MODE=true
